{
  "name": "Chroma Studio",
  "short_name": "Chroma Studio",
  "description": "Every Color. Every Code. One Creative Workspace.",
  "id": "/?source=pwa",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#090A0F",
  "theme_color": "#090A0F",
  "lang": "en",
  "dir": "ltr",
  "categories": ["design", "utilities", "developer tools", "productivity"],
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "16x16 32x32",
      "type": "image/x-icon"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Color Picker",
      "short_name": "Picker",
      "description": "Select colors with 2D HSV canvas, 360° hue bar, and cross-format inspector",
      "url": "/#/tools/picker",
      "icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Color Converter",
      "short_name": "Converter",
      "description": "Bidirectional conversion between HEX, RGB, HSL, HSV, and CMYK",
      "url": "/#/tools/converter",
      "icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Contrast Checker",
      "short_name": "Contrast",
      "description": "Test WCAG 2.2 AA and AAA contrast accessibility ratios",
      "url": "/#/tools/contrast",
      "icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Palette Generator",
      "short_name": "Palettes",
      "description": "Generate harmonious color schemes and lock specific tones",
      "url": "/#/tools/palette",
      "icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
    }
  ]
}
